# Email delivery for order lists (https://resend.com — free tier is enough).
# Without RESEND_API_KEY the site still works: "Send order list" opens the
# visitor's email app with the list pre-filled and addressed to info@mustanira.com.
RESEND_API_KEY=

# Where order lists are delivered (defaults to info@mustanira.com)
ORDER_TO_EMAIL=info@mustanira.com

# Sender address. Must be on a domain verified in Resend, e.g. orders@mustanira.com.
# Resend's test sender (onboarding@resend.dev) can only deliver to your own Resend account email.
ORDER_FROM_EMAIL=Mustanira Orders <orders@mustanira.com>

# Public URL, used for sitemap / social previews
NEXT_PUBLIC_SITE_URL=https://mustanira.com
